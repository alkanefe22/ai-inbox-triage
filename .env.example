# Secret key n8n uses to encrypt stored credentials; set once and never change it.
N8N_ENCRYPTION_KEY=

# AI provider used by workflows: ollama (local dev/eval) or gemini (demo).
AI_PROVIDER=ollama

# Ollama base URL as seen from inside the n8n container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model name read by workflows via $env.OLLAMA_MODEL.
OLLAMA_MODEL=

# Google Gemini API key from Google AI Studio (free tier).
GEMINI_API_KEY=

# Gemini model name read by workflows via $env.GEMINI_MODEL.
GEMINI_MODEL=

# Optional pause between Gemini calls in ms (default 6500 if empty, fits the free tier per-minute limit).
GEMINI_DELAY_MS=

# Emails whose classification confidence (0-1) is below this go to "needs_review" instead of a category (default 0.7 if empty).
REVIEW_THRESHOLD=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID that receives notifications.
TELEGRAM_CHAT_ID=

# Google Sheets spreadsheet ID (the part between /d/ and /edit in the URL).
GOOGLE_SHEET_ID=

# Optional n8n credential ID for the Google Sheets node (not a secret; copy it from the credential URL in n8n).
N8N_SHEETS_CREDENTIAL_ID=

# Optional host port for the n8n UI and webhook (default 5678).
N8N_HOST_PORT=

# Optional Docker Compose project name, used for the container and volume names (default ai-inbox-triage).
COMPOSE_PROJECT_NAME=

# n8n timezone for schedules and date functions (defaults to Europe/Istanbul if empty).
GENERIC_TIMEZONE=

# Container OS timezone (defaults to Europe/Istanbul if empty).
TZ=
