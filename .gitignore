# Secrets
.env
.env.*
!.env.example

# Generated output (keep folder)
output/*
!output/.gitkeep

# Demo videos (only docs/demo.gif is committed; the MP4 is shared separately)
docs/demo-raw.mp4
docs/demo.mp4
docs/*.tmp.*

# Paid Gumroad package (built locally, never committed)
gumroad/

# Dependencies
node_modules/

# Key and credential files (never commit these)
*.pem
*.key
*.p12
*.pfx
*-key.json
*_key.json
*service-account*.json
*service_account*.json
credentials*.json
client_secret*.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Human corrections can contain real emails (see eval/corrections/README.md)
eval/corrections/*.json
